# Copia este archivo a .env y completa las claves. Nunca subas .env al repositorio.

# --- Claves ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Integraciones de tus compañeros ---
# Web de la clínica donde el agente hace el trámite (la construye el Compañero 1).
CLINIC_PORTAL_URL=http://localhost:8080
# Panel del cuidador desplegado (lo construye el Compañero 2). Si pones solo la URL del sitio, cada evento se envía
# por POST a {URL}/api/logs, que es el esquema de logs del panel. Si la URL ya trae una ruta, se usa tal cual.
CAREGIVER_PANEL_URL=https://panel-cuidador.vercel.app/

# --- Orquestador LLM (Anthropic) ---
# El brief pedía claude-3-5-sonnet-20241022, pero ese modelo fue retirado (28-oct-2025).
# Se usa el Sonnet vigente. OJO: no uses nombres CLAUDE_* para esto; Claude Code define CLAUDE_EFFORT en su entorno.
LLM_MODEL=claude-sonnet-5-5
# low = respuestas rápidas (lo que importa en voz). Sube a medium/high si quieres más razonamiento.
LLM_EFFORT=low
# Esfuerzo del agente que navega el portal (segundo plano, importa más la fiabilidad que la velocidad).
AGENT_EFFORT=medium
# Si el clasificador de seguridad rechaza una petición, la API reintenta en otro modelo (solo API de Anthropic).
LLM_REFUSAL_FALLBACK=true

# --- Speech-to-Text (Groq Whisper) ---
GROQ_STT_MODEL=whisper-large-v3
STT_LANGUAGE=es

# --- Text-to-Speech (edge-tts) ---
# Para escuchar y comparar voces:  python -m app.tts --audition    (la lista completa: python -m app.tts --list)
# TTS_RATE más lento (p. ej. -5%) ayuda a entender, pero suena menos natural.
TTS_VOICE=es-CL-CatalinaNeural
TTS_RATE=+0%

# --- Personas ---
# Datos GUARDADOS de la persona mayor. Si los completas, la IA no se los pide: al reservar dice que rellena todo con
# sus datos guardados. Si los dejas vacíos, se los pide por voz. El RUT se acepta con o sin puntos y guion.
ELDER_NAME=Eliecer
CAREGIVER_NAME=Camila
PATIENT_FULL_NAME=
PATIENT_RUT=
PATIENT_PHONE=
PATIENT_AGE=
# Número al que se le indica llamar ante una emergencia (131 = SAMU en Chile).
EMERGENCY_NUMBER=131
TIMEZONE=America/Santiago

# --- Agente de navegación (Playwright) ---
# false = ventana visible (demos). auto = visible si hay pantalla, si no headless. true = siempre headless.
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=300
# Segundos que se deja abierta la confirmación antes de cerrar el navegador (para apreciarla en demos).
BROWSER_KEEP_OPEN_S=3
AGENT_MAX_STEPS=25
AGENT_TIMEOUT_S=240
